{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Xyst AI Agent",
  "version": "0.1.1",
  "identifier": "dev.xyst.xaa",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5173"
  },
  "app": {
    "windows": [{ "title": "Xyst AI Agent", "visible": false, "width": 1180, "height": 860, "minWidth": 700, "minHeight": 600 }],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*; img-src 'self' data:" }
  },
  "bundle": { "active": false, "externalBin": ["binaries/xaa-engine"] }
}
