{
  "name": "xaa-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build:native:dev": "npm run build:desktop && uv run python scripts/build_engine.py && cargo build --manifest-path apps/desktop/src-tauri/Cargo.toml --features custom-protocol && uv run python scripts/stage_native.py",
    "test:browser": "playwright test",
    "test:native:commands": "node scripts/native_command_smoke.mjs",
    "test:native:mcp": "node scripts/native_mcp_smoke.mjs",
    "dev:desktop": "vite apps/desktop --host 127.0.0.1",
    "build:desktop": "npm run typecheck && vite build apps/desktop",
    "contracts": "node scripts/generate-types.mjs",
    "contracts:check": "node scripts/generate-types.mjs --check",
    "typecheck": "tsc --noEmit",
    "test:client": "node --test tests/client.mjs",
    "build:installer": "uv run python scripts/build_installer.py"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tauri-apps/cli": "2.12.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
